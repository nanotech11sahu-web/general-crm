{
  "name": "leaddesk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @leaddesk/db migrate",
    "dev:api": "pnpm --filter @leaddesk/api dev",
    "dev:worker": "pnpm --filter @leaddesk/worker dev",
    "dev:ingress": "pnpm --filter @leaddesk/webhook-ingress dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@swc/core": "^1.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  },
  "pnpm": { "onlyBuiltDependencies": ["@swc/core", "esbuild", "argon2", "mongodb-memory-server", "msgpackr-extract"] }
}
