# Platform-level secrets ONLY. Client integration credentials live encrypted in the database.
MONGO_URL=mongodb://localhost:27017/leaddesk?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=            # 32+ random chars (openssl rand -base64 48). Required; production refuses placeholders
# 32-byte key, base64. Dev only (LocalKeyService). Prod uses AWS KMS.
LOCAL_KEK_BASE64=
KMS_KEY_ID=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me

# Provider *app* credentials (platform-level; clients' tokens live encrypted in the DB)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used to build OAuth redirect URIs and post-connect redirects
PUBLIC_API_URL=
PUBLIC_APP_URL=

# --- Recordings / object storage (Phase 4b) ---
# Filesystem store (dev / single node). Use S3_* below for production.
RECORDINGS_DIR=./data/objects
# Signs the short-lived recording URLs. Required in production; must be identical on api, worker and ingress.
OBJECT_SIGNING_SECRET=
# Public URL of the webhook-ingress service: providers call back here (Exotel call status).
PUBLIC_INGRESS_URL=
# S3-compatible store (optional)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI (Phase 6) ---
# Clients bring their own Groq key (Connections -> Groq); it is stored encrypted like any credential.
# No platform key is read by the app. Model routing is config, not code; features refuse to run on a model the key does not list.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_FAST=openai/gpt-oss-20b
AI_MODEL_SMART=openai/gpt-oss-120b

# --- HTTP hardening (Phase 7) ---
# Comma-separated extra browser origins allowed to call the API with credentials. Empty = same-origin only (the web app proxies /v1).
CORS_ORIGINS=
# Number of reverse proxies / load balancers in front of the API & ingress (so rate limits see the real client IP). Leave empty when directly exposed.
TRUST_PROXY=
# Multiplier for all abuse limits (e.g. 0.5 halves them). RATE_LIMITS=off is for local tests only and refused in production.
RATE_LIMIT_SCALE=1
LOG_LEVEL=info

# --- Billing (Phase 8) ---
# Plan prices/limits in code are PLACEHOLDERS. Override the whole catalogue with JSON if needed.
PLANS_JSON=
# Razorpay (checkout via hosted link; webhook POST /hooks/billing/razorpay). Not verified against the live service.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan ids per paid tier (created in the Razorpay dashboard)
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_SCALE=

# --- Operator (support) API (Phase 8) ---
# /platform/* answers 404 unless this is >= 32 chars. Counts/metadata only, no impersonation, every call audited.
PLATFORM_ADMIN_TOKEN=
# Optional comma-separated IP allow-list for /platform/*
PLATFORM_ADMIN_IPS=
