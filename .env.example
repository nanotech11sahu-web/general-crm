# Platform-level secrets ONLY. Client integration credentials live encrypted in the database.
MONGO_URL=mongodb://localhost:27017/leaddesk?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# 32-byte key, base64. Dev only (LocalKeyService). Prod uses AWS KMS.
LOCAL_KEK_BASE64=
KMS_KEY_ID=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me
# Dev/testing only AI settings. Never commit real keys.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Provider *app* credentials (platform-level; clients' tokens live encrypted in the DB)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used to build OAuth redirect URIs and post-connect redirects
PUBLIC_API_URL=
PUBLIC_APP_URL=
