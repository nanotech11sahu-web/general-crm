# Platform-level secrets ONLY. Client integration credentials live encrypted in the database.
MONGO_URL=mongodb://localhost:27017/leaddesk?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# 32-byte key, base64. Dev only (LocalKeyService). Prod uses AWS KMS.
LOCAL_KEK_BASE64=
KMS_KEY_ID=
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=change-me

# Provider *app* credentials (platform-level; clients' tokens live encrypted in the DB)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Used to build OAuth redirect URIs and post-connect redirects
PUBLIC_API_URL=
PUBLIC_APP_URL=

# --- Recordings / object storage (Phase 4b) ---
# Filesystem store (dev / single node). Use S3_* below for production.
RECORDINGS_DIR=./data/objects
# Signs the short-lived recording URLs. Required in production; must be identical on api, worker and ingress.
OBJECT_SIGNING_SECRET=
# Public URL of the webhook-ingress service: providers call back here (Exotel call status).
PUBLIC_INGRESS_URL=
# S3-compatible store (optional)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI (Phase 6) ---
# Clients bring their own Groq key (Connections -> Groq); it is stored encrypted like any credential.
# No platform key is read by the app. Model routing is config, not code; features refuse to run on a model the key does not list.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_FAST=openai/gpt-oss-20b
AI_MODEL_SMART=openai/gpt-oss-120b
