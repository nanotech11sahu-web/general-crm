PORT=4000
MONGO_URI=mongodb://localhost:27017/pmc_crm
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173

# Publicly reachable URL of THIS backend (must be HTTPS in production). Meta redirects the
# browser back to {API_PUBLIC_URL}/api/ad-launcher/accounts/meta/oauth-callback after login.
API_PUBLIC_URL=http://localhost:4000

# Used to encrypt third-party access tokens/API keys at rest (AES-256-GCM). Generate a real
# random value for production, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_to_a_random_32_byte_value

# Meta (Facebook/Instagram) app credentials are NOT set here — this CRM is meant to be used
# by many separate workspaces/customers, and each one registers and enters its own Meta app
# (App ID + App Secret) from inside the product: Settings > App Store > Meta App. That screen
# shows the exact redirect URI to add to their app at https://developers.facebook.com/apps
# ({API_PUBLIC_URL}/api/ad-launcher/accounts/meta/oauth-callback).
